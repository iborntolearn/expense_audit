# ---------------------------------------------------------------------------
# Pre-Approval Expense Audit - Simulation Mode configuration
# Copy to `.env` and adjust. NEVER commit a real .env or any secret.
# ---------------------------------------------------------------------------

# Data source switch. Setting this to "live" has NO EFFECT in this build -
# it is not enough on its own. Live behavior requires three gates (a real T&E
# connector, real-data governance/legal sign-off, completed threat-model
# remediation - Solution Design 12, Build Brief 2.2) that are hardcoded off in
# config/settings.py (LIVE_MODE_GATES_SATISFIED), NOT read from this file. Even
# with SIMULATION_MODE=live, the system still tags all data is_synthetic=true
# and the webhook still rejects with a 501 explaining why.
SIMULATION_MODE=simulation

# Persistence backend. "sqlite_local" runs with no Docker/Postgres (dev
# fallback). "postgres" uses the pinned Postgres + pgvector stack.
STORAGE_BACKEND=sqlite_local

# --- sqlite_local backend ---
SQLITE_PATH=./.data/audit.db

# --- postgres backend (used only when STORAGE_BACKEND=postgres) ---
POSTGRES_DSN=postgresql://audit:audit@localhost:5432/audit

# Where receipt blobs are stored on the local filesystem (simulation only).
BLOB_ROOT=./.data/blobs

# --- Vision / embedding models (adapters read these; never hardcode a model) ---
# Left blank in Phase 0 - no LLM calls are made yet.
ANTHROPIC_API_KEY=
LLM_VISION_MODEL=claude-sonnet-5
EMBEDDING_DIM=1536

# --- Azure OpenAI vision (GPT-4.1 etc.) ---
# Env var names match the SOA Layout Agent app for config parity.
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_DEPLOYMENT_NAME=gpt-4.1
AZURE_API_VERSION=2024-08-01-preview

# App
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
